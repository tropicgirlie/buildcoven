# Cloudflare — free tier (Workers + D1)
# 1. npm run db:create  → copy database_id into wrangler.jsonc
# 2. npm run db:migrate:local && npm run db:seed:local
# 3. npm run preview:cf  (or deploy)

# Admin MVP protection (optional — use Cloudflare Access in production)
ADMIN_SECRET=change-me-in-production

# Stripe — Payment Links or Checkout
# TODO: Create Payment Link for Pilot 001 ($597)
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/your-link
STRIPE_SECRET_KEY=sk_test_...

# Resend — application confirmation emails
# TODO: Wire in /api/applications POST (Worker-compatible fetch)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@buildcoven.com
